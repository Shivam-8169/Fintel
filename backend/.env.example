# Fintel Environment Configuration
# Academic PBL Prototype - Do NOT commit actual production secrets

DATABASE_URL=sqlite:///./fintel.db
ENVIRONMENT=development

# Authentication
JWT_SECRET=fintel-dev-secret-key-super-secure-for-academic-demo-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# LLM Configuration (Optional: system automatically falls back to deterministic Demo/Mock mode if key is empty)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=
DEMO_MODE=true

# Detection Thresholds
DETECTION_THRESHOLD=60
RAPID_MOVEMENT_WINDOW_HOURS=24
HIGH_VALUE_THRESHOLD=50000.0
STRUCTURING_THRESHOLD=9500.0
STRUCTURING_LOWER_BOUND=8000.0
HIGH_VELOCITY_TX_COUNT=5
HIGH_VELOCITY_WINDOW_HOURS=12
FAN_OUT_IN_DEGREE_THRESHOLD=4
